## Line ending & binary normalization rules
## - Default: normalize text to LF in repo/worktree
## - Windows scripts: keep CRLF
## - Binary assets: never attempt text conversions

# Auto-detect text, normalize to LF
* text=auto eol=lf

# Common text types (explicit)
*.py      text eol=lf
*.pyi     text eol=lf
*.md      text eol=lf
*.txt     text eol=lf
*.json    text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.toml    text eol=lf
*.ini     text eol=lf
*.cfg     text eol=lf
*.xml     text eol=lf
*.urdf    text eol=lf
*.sdf     text eol=lf
*.mjcf    text eol=lf
*.gitignore text eol=lf

# Shell scripts
*.sh      text eol=lf

# Windows scripts
*.bat     text eol=crlf
*.cmd     text eol=crlf
*.ps1     text eol=crlf

# Binary assets (Unity / 3D / media)
*.stl     binary
*.STL     binary
*.fbx     binary
*.FBX     binary
*.dae     binary
*.DAE     binary
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.webp    binary
*.mp4     binary
*.mov     binary
*.avi     binary
*.zip     binary
*.7z      binary
*.rar     binary
